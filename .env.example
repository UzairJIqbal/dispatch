# Copy to .env in the repo root and fill in there. Never put a real key in
# this file: it is committed.

# Primary provider. Free key, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Fallback provider. Free trial key, no card: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# Optional: added latency per mock call, in milliseconds.
# MOCK_DELAY_MS=300
