# Copy to .env in the repo root and fill in there. Never put a real key in
# this file: it is committed.

# --- Model providers ---
# Primary provider. Free key, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Fallback provider. Free trial key, no card: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# --- The service ---
# Client keys as name:sha256-of-key, comma-separated. `pnpm client-key <name>` makes one.
DISPATCH_CLIENT_KEYS=
# Upstash Redis (rate limits). console.upstash.com → your database → REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Which provider the service calls: mock, gemini or cohere. Unset = the prompt's model alias. pnpm dev and docker compose default to mock.
# DISPATCH_PROVIDER=mock
# Port the service listens on (default 3000).
# PORT=3000
# Host port docker compose publishes the service on (default 3000).
# DISPATCH_HOST_PORT=3000
# Log level: debug, info, warn or error (default info).
# LOG_LEVEL=info
# The commit being run. Baked into the Docker image; locally it's read from git.
# GIT_SHA=

# --- Tracing (Langfuse over OpenTelemetry) ---
# Langfuse → your project → Settings → API Keys. Without both keys traces go nowhere (one warning, requests unaffected).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# https://cloud.langfuse.com (EU, default) or https://us.cloud.langfuse.com (US), whichever your project is on.
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Share of requests traced, 0 to 1 (default 1). 0.1 for load tests.
# TRACE_SAMPLE_RATE=1
# Local debugging only: puts the ticket and answer in spans, emails and phones redacted. Ignored with NODE_ENV=production.
# TRACE_CAPTURE_CONTENT=false

# --- Testing and drills (mock provider only) ---
# Breaks the primary mock: ok, 429, 500, hang, bad_json, bad_json_once, slow, 400, 401, 400_key or connection.
# MOCK_MODE=500
# The same for the fallback mock (default ok), to drill "every provider down".
# MOCK_FALLBACK_MODE=500
# Seconds the 429 mode sends as Retry-After. Unset = no Retry-After header.
# MOCK_RETRY_AFTER=2
# Optional: added latency per mock call, in milliseconds.
# MOCK_DELAY_MS=300

# --- Metrics and dashboards ---
# Grafana admin password for docker compose (user admin). Required by compose. `openssl rand -hex 16`.
GRAFANA_ADMIN_PASSWORD=
# Basic auth on GET /metrics, user `metrics`, at least 16 characters. Unset = open (fine locally; compose leaves it open on its private network). Set it when deployed.
# METRICS_PASSWORD=
# Raw client keys `pnpm traffic` sends with, comma-separated, one per 45 requests a minute (2 for the default 1 RPS).
# Their name:hash lines go in DISPATCH_CLIENT_KEYS like any client.
DISPATCH_TRAFFIC_KEYS=
