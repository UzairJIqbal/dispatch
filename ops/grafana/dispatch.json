{
  "uid": "dispatch",
  "title": "Dispatch",
  "description": "Live view of the triage service: traffic, latency and errors against the SLOs in docs/SLOS.md.",
  "tags": [
    "dispatch",
    "slo"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Availability, 7 days",
      "description": "Share of /v1/triage requests that weren't a 5xx, over the SLO window. SLO 99% (docs/SLOS.md). Baseline: 100% of 74 test-split calls. Client errors (4xx) aren't counted either way.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - (sum(increase(dispatch_requests_total{route=\"/v1/triage\",status=~\"5..\"}[7d])) / sum(increase(dispatch_requests_total{route=\"/v1/triage\",status!~\"4..\"}[7d])))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "no traffic yet"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error budget left",
      "description": "The 1% of requests the 99% SLO lets fail in 7 days, minus what has failed. Below 0: the SLO is missed.",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - ((sum(increase(dispatch_requests_total{route=\"/v1/triage\",status=~\"5..\"}[7d])) / sum(increase(dispatch_requests_total{route=\"/v1/triage\",status!~\"4..\"}[7d]))) / 0.01)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "no traffic yet"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Burn rate, 1 h",
      "description": "How fast the budget is going: 1x lasts exactly 7 days. The fast-burn alert fires above 14.4x on both the 1 h and the 5 min window.",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(dispatch_requests_total{route=\"/v1/triage\",status=~\"5..\"}[1h])) / sum(rate(dispatch_requests_total{route=\"/v1/triage\",status!~\"4..\"}[1h]))) / 0.01",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
