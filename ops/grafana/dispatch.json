    {
      "id": 5,
      "type": "stat",
      "title": "Cost per 1,000 answers, 7 days",
      "description": "List-price estimate per 1,000 successful requests. SLO at most $0.40. Baseline $0.28 (Gemini, 74 test-split calls). The free tiers actually cost $0.",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1000 * sum(increase(dispatch_cost_usd_total[7d])) / sum(increase(dispatch_requests_total{route=\"/v1/triage\",status=\"200\"}[7d]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.4
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "no traffic yet"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
