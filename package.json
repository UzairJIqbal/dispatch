{
  "name": "dispatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "golden:import": "tsx scripts/golden-import.ts",
    "label": "tsx scripts/label.ts",
    "golden:stats": "tsx scripts/golden-stats.ts",
    "eval": "tsx scripts/eval.ts",
    "eval:noise": "tsx scripts/eval-noise.ts",
    "dev": "DISPATCH_PROVIDER=${DISPATCH_PROVIDER:-mock} tsx watch src/server/main.ts",
    "client-key": "tsx scripts/client-key.ts",
    "traffic": "tsx scripts/traffic.ts",
    "smoke": "tsx scripts/smoke.ts",
    "grafana:push": "tsx scripts/grafana-push.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "packageManager": "pnpm@12.9.1",
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.0.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.40.0",
    "csv-parse": "^7.0.3",
    "express": "^5.3.0",
    "openai": "^7.43.0",
    "pino": "^10.4.0",
    "prom-client": "15.1.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
